dist/
*.tsbuildinfo
.env
.env.*
!.env.example

# Reference checkout of deepseek-harness: read-only, not part of this project.
.reference/

# Test credentials. Never commit.
key.txt
*.key
secrets.json

# Runtime data: imported cards, chat logs, settings. Belongs to whoever runs
