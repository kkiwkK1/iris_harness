{
  "name": "iris",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "A SillyTavern alternative built on the Cordis plugin architecture.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node apps/iris/bin.ts",
    "test": "node --test \"packages/*/tests/**/*.test.ts\" \"apps/*/tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "gate": "node scripts/gate.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:template-differential": "node scripts/template-differential.mjs",
    "test:regex-differential": "node scripts/regex-differential.mjs",
    "census:cache-cause": "node scripts/cache-cause-census.mjs",
    "census:card-scripts": "node scripts/card-script-census.mjs",
    "census:card-surface": "node scripts/card-surface-census.mjs",
    "census:frontend-blocks": "node scripts/frontend-block-census.mjs",
    "census:read-view": "node scripts/read-view-census.mjs",
    "census:settings-usage": "node scripts/settings-usage-census.mjs",
    "census:th-members": "node scripts/th-member-census.mjs",
    "test:no-corpus": "node scripts/check-corpus-skips.mjs",
    "pack:contracts": "node scripts/pack-contracts.mjs",
    "demo:mvu": "node apps/iris/demo/mvu-roleplay.ts",
    "build:web": "npm --prefix apps/iris-web run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
