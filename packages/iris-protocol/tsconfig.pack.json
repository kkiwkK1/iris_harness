{
  // The publishing emit for this contract package. Extends the repository base
  // rather than restating it, so `target`, `lib` and the strictness settings
  // are the ones the workspace typechecks against by construction — a second
  // copy of `target` here would be a constant that drifts silently.
  //
  // Only the emit is different, and only here: the workspace still runs
  // `./src/index.ts` through Node's type stripping (`exports` is untouched),
  // and nothing reads this file except `scripts/pack-contracts.mjs`.
  //
  // `rewriteRelativeImportExtensions` is what makes the emit importable: the
  // sources say `./views.ts`, and without it that specifier survives into
  // `lib/index.js`, where no `.ts` file exists beside it.
  //
  // `declarationMap` and `sourceMap` are **off**, and so is `inlineSources`
  // (which only *has* meaning alongside a source map). The tarball ships `lib`
  // and nothing else — no `src/` — so both maps pointed at files a consumer
  // does not have: a `.d.ts.map` whose `"sources": ["../../src/index.ts"]`
  // resolves to nothing, and a `.js.map` that inlines the source to stand in
  // for a file it cannot point at. A dangling map is worse than an absent one:
  // an editor offering "go to definition" follows it and lands nowhere. The
  // declarations themselves (`declaration: true`) are what consumers read, and
  // they stay.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "rewriteRelativeImportExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "../../dist-pack/protocol/lib"
  },
  "include": ["src/**/*.ts"]
}
