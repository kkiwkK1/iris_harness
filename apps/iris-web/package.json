{
  "name": "@iris/web",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vite entry over the DSH web shell. npm-managed; see README for why.",
  "scripts": {
    "build": "npm run build:sandbox && vite build && node tools/prune-sandbox-assets.mjs dist/sandbox && node tools/prune-app-assets.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:render": "node tools/render-check.mjs",
    "build:sandbox": "vite build --config vite.sandbox.config.ts && vite build --config vite.members.config.ts && vite build --config vite.preset.config.ts && vite build --config vite.message-preset.config.ts && node tools/hash-sandbox-assets.mjs && node tools/check-bootstrap.mjs && node tools/check-preset.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-client-modules": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-web": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@fortawesome/fontawesome-free": "6.5.2",
    "@iris/client-fake": "file:../../packages/iris-client-fake",
    "@iris/compat-tavernhelper-core": "file:../../packages/iris-compat-tavernhelper-core",
    "@iris/plugin-web-api": "file:../../packages/iris-plugin-web-api",
    "@iris/protocol": "file:../../packages/iris-protocol",
    "@iris/text": "file:../../packages/iris-text",
    "@tailwindcss/browser": "4.1.12",
    "dompurify": "^3.4.14",
    "jquery": "3.5.1",
    "jquery-ui": "1.13.2",
    "jquery-ui-touch-punch": "0.2.3",
    "lodash-es": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "showdown": "2.1.0",
    "vue": "3.5.42",
    "vue-router": "4.6.4",
    "yaml": "^2.8.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
